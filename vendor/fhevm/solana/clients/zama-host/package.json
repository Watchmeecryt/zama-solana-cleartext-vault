{
  "name": "@fhevm/solana-zama-host",
  "private": true,
  "version": "0.15.0-0",
  "description": "Codama client for the zama-host program (regenerated by npm run codegen:solana in sdk/js-sdk), and the version 1 signing and finalized sending every Solana client uses.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/finalizedClient.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "setup": "npm ci && npm run build",
    "build": "rm -rf dist && tsc --declaration --declarationDir dist/types && tsc --module commonjs --moduleResolution node --ignoreDeprecations 6.0 --verbatimModuleSyntax false --outDir dist/cjs && printf '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-instruction-plan": "^0.19.0",
    "@solana/program-client-core": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit-plugin-instruction-plan": {
      "optional": true
    },
    "@solana/kit-plugin-rpc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-instruction-plan": "0.19.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/program-client-core": "8.4.0",
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  },
  "license": "BSD-3-Clause-Clear"
}
