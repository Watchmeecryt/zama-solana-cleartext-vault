{
  "include": ["./**/*.ts"],
  "exclude": [
    "./_cjs/**",
    "./_esm/**",
    "./_types/**",
    "./**/*.test.ts",
    "./**/*.test-d.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
