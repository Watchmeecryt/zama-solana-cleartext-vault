# syntax=docker/dockerfile:1
# Single Railway service: cleartext Solana validator + keeper/API + static dApp.
# Public base images only. linux/amd64 — Agave CLI is not published for arm64.

ARG SOLANA_VERSION=4.3.0
ARG ANCHOR_VERSION=1.2.0

FROM --platform=linux/amd64 ubuntu:24.04 AS sbf
ARG SOLANA_VERSION
ARG ANCHOR_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git bzip2 build-essential pkg-config libudev-dev libssl-dev python3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.91.1
ENV PATH="/root/.cargo/bin:${PATH}"

RUN curl -sSfL "https://release.anza.xyz/v${SOLANA_VERSION}/install" -o /tmp/anza-install.sh \
    && sh /tmp/anza-install.sh \
    && rm /tmp/anza-install.sh
ENV PATH="/root/.local/share/solana/install/active_release/bin:${PATH}"

RUN curl -sSfL "https://github.com/otter-sec/anchor/releases/download/v${ANCHOR_VERSION}/anchor-${ANCHOR_VERSION}-x86_64-unknown-linux-gnu" \
      -o /usr/local/bin/anchor \
    && chmod +x /usr/local/bin/anchor \
    && solana --version && anchor --version

WORKDIR /src/solana
COPY vendor/fhevm/solana/Anchor.toml vendor/fhevm/solana/Cargo.toml vendor/fhevm/solana/Cargo.lock vendor/fhevm/solana/rust-toolchain.toml ./
COPY vendor/fhevm/solana/environments/ environments/
COPY vendor/fhevm/solana/programs/ programs/
COPY vendor/fhevm/solana/crates/ crates/
COPY vendor/fhevm/solana/runtime-tests/ runtime-tests/
COPY vendor/fhevm/solana/test-kit/ test-kit/
COPY vendor/fhevm/solana/.cargo/ .cargo/
COPY vendor/fhevm/solana/scripts/build-programs.sh vendor/fhevm/solana/scripts/install-sbf-tools.sh scripts/
RUN rustup show && bash scripts/build-programs.sh preview-env \
      zama_host_cleartext confidential_token demo_vault confidential_batcher

FROM --platform=linux/amd64 oven/bun:1.3.14-debian AS web
WORKDIR /src
COPY package.json package-lock.json* bun.lock* ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/demo/package.json packages/demo/package.json
COPY vendor/fhevm/sdk/js-sdk/src/package.json vendor/fhevm/sdk/js-sdk/src/package.json
COPY vendor/fhevm/solana/clients/zama-host/package.json vendor/fhevm/solana/clients/zama-host/package.json
COPY vendor/fhevm/solana/clients/confidential-token/package.json vendor/fhevm/solana/clients/confidential-token/package.json
COPY vendor vendor
COPY packages packages
COPY apps/web apps/web
COPY apps/api apps/api
# Install after sources are present so workspace-local node_modules are not overwritten.
RUN bun install
WORKDIR /src/apps/web
RUN bun run check && bun run build
WORKDIR /src
# Fail the image build if the API entrypoint cannot resolve a runtime package.
RUN bun build apps/api/src/index.ts --target=bun --outdir=/tmp/api-bundle

FROM --platform=linux/amd64 oven/bun:1.3.14-debian AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3 libudev1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=sbf /root/.local/share/solana/install/active_release /usr/local/solana
ENV PATH="/usr/local/solana/bin:${PATH}"

WORKDIR /app
COPY --from=web /src/package.json /app/package.json
COPY --from=web /src/node_modules /app/node_modules
COPY --from=web /src/vendor /app/vendor
COPY --from=web /src/packages /app/packages
COPY --from=web /src/apps/api /app/apps/api
# bun may leave unhoisted deps in workspace node_modules; keep those next to the sources.
COPY --from=web /src/apps/web/dist /app/public
COPY --from=sbf /src/solana/target/deploy/zama_host_cleartext.so /app/programs/zama_host_cleartext.so
COPY --from=sbf /src/solana/target/deploy/confidential_token.so /app/programs/confidential_token.so
COPY --from=sbf /src/solana/target/deploy/demo_vault.so /app/programs/demo_vault.so
COPY --from=sbf /src/solana/target/deploy/confidential_batcher.so /app/programs/confidential_batcher.so
COPY scripts /app/scripts

ENV DATA_DIR=/data
ENV LEDGER_DIR=/data/ledger
ENV PROGRAMS_DIR=/app/programs
ENV PUBLIC_DIR=/app/public
ENV HOME=/root
RUN mkdir -p /data /data/ledger /data/keys && chmod -R 777 /data
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=5s --start-period=90s CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"
CMD ["bun", "run", "apps/api/src/index.ts"]
